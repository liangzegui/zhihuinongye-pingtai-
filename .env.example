# =============================================
# 智慧农业监控平台 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# =============================================

# ========== 数据库配置 ==========
DATABASE_URL=jdbc:mysql://localhost:3306/agri_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password

# ========== Docker MySQL ==========
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# ========== 华为云 IoTDA 配置 ==========
# IoTDA 接入地址（根据区域选择）
IOTDA_ENDPOINT=https://iotda.cn-south-1.myhuaweicloud.com
# 华为云项目ID（在"我的凭证"中查看）
IOTDA_PROJECT_ID=your_project_id
# AK/SK 认证密钥
IOTDA_AK=your_access_key
IOTDA_SK=your_secret_key
# ESP32 设备ID
IOTDA_DEVICE_ID=your_device_id
# IoTDA 实例ID
IOTDA_INSTANCE_ID=your_instance_id

# ========== ESP32 设备配置 ==========
ESP32_BASE_URL=http://192.168.2.92

# ========== 服务端口 ==========
PORT=8080
CORS_ORIGINS=http://localhost:8081
